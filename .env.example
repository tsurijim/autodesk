# =====================================================
# Autodesk Diagnosis Platform - Environment Variables
# =====================================================
# 
# This is an EXAMPLE file. Copy to .env and fill in your values
# DO NOT commit .env to Git - it contains sensitive information
#

# =====================================================
# SERVER CONFIGURATION
# =====================================================

# Node environment: development, production, test
NODE_ENV=production

# Server port (Hostinger default: 8080)
PORT=8080

# Server host (0.0.0.0 allows external connections)
HOST=0.0.0.0

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# 
# For local development: use localhost
# For Hostinger: see HOSTINGER_LIVE_TEST_CHECKLIST.md
#

# MySQL hostname/IP
DB_HOST=localhost

# MySQL username
DB_USER=autodesk_user

# MySQL password (KEEP THIS SECURE!)
DB_PASSWORD=your_secure_password_here

# Database name
DB_NAME=autodesk_diagnosis

# MySQL port (default: 3306)
DB_PORT=3306

# Connection pool size
DB_POOL_SIZE=10

# =====================================================
# API CONFIGURATION
# =====================================================

# API version
API_VERSION=1.0.0

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# =====================================================
# LOGGING
# =====================================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# =====================================================
# DEPLOYMENT SPECIFIC
# =====================================================

# For Hostinger:
# 1. Create .env file with these values filled in
# 2. Use real Hostinger MySQL credentials
# 3. Set NODE_ENV=production
# 4. Do NOT push .env to GitHub (it's in .gitignore)

# Example Hostinger configuration:
# DB_HOST=mysql123.hostinger.com
# DB_USER=u12345_autodesk
# DB_PASSWORD=your_hostinger_db_password
# DB_NAME=u12345_autodesk_diagnosis
